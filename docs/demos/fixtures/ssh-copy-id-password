#!/usr/bin/env bash
set -euo pipefail

printf '%s' "builder@mac-studio.example-net.ts.net's password: "
stty -echo
IFS= read -r password
stty echo
printf '\n'
if [ "$password" != "camp-demo-password" ]; then
    echo "Permission denied, please try again." >&2
    exit 1
fi

touch "${CAMP_VHS_ROOT:?}/access-installed"
echo "Number of key(s) added: 1"
