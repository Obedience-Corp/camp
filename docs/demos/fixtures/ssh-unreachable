#!/usr/bin/env bash
# A stand-in for ssh that never connects, used only when recording
# docs/demos/machine-diagnose-dns.tape.
#
# It reproduces the two distinct ways OpenSSH fails, choosing between them the
# same way ssh does — by whether the destination resolves — because telling
# those two apart is the entire subject of that recording:
#
#   unresolvable  "Could not resolve hostname ...: Name or service not known"
#   resolvable    "connect to host ... port 22: Connection refused"
#
# The lookup below is real, against the same resolver camp uses. The invented
# tailnet in the tape (example-net.ts.net) genuinely does not resolve, so the
# first branch is reached honestly rather than hard-coded; a stub that always
# printed the resolution error would be recording a claim instead of testing one.
#
# Exiting immediately (rather than hanging to a timeout) keeps the tape short.
# camp treats any non-zero exit from the version probe alike.
set -euo pipefail

# Find the destination: the first argument that is neither a flag nor the value
# belonging to one. Mirrors the probe camp builds (`ssh -o BatchMode=yes
# user@host true`) without needing to parse all of ssh's option grammar.
dest=""
skip_next=0
for arg in "$@"; do
    if [ "$skip_next" -eq 1 ]; then
        skip_next=0
        continue
    fi
    case "$arg" in
        -o | -i | -l | -p | -F) skip_next=1 ;;
        -*) ;;
        *)
            dest="$arg"
            break
            ;;
    esac
done

host="${dest#*@}"

# An address literal is already an address, exactly as camp's own check treats
# it (checkHostResolves). Without this, `getent hosts 100.64.0.2` would attempt
# a reverse lookup, find no PTR record, and report a routable address as
# unresolvable.
is_ip_literal() {
    [[ "$1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || [[ "$1" == *:* ]]
}

if [ -n "$host" ] && ! is_ip_literal "$host" && ! getent hosts "$host" >/dev/null 2>&1; then
    echo "ssh: Could not resolve hostname $host: Name or service not known" >&2
    exit 255
fi

echo "ssh: connect to host $host port 22: Connection refused" >&2
exit 255
